//
// Hand-written planted fault, never a production kernel: qualify_uninit_shared loads a
// shared word no thread stored. Only the UninitShared mutant loads this module
//

.version 6.3
.target sm_75
.address_size 64

.shared .align 4 .u32 qualify_uninit_slot;

.visible .entry qualify_uninit_shared(
	.param .u64 qualify_uninit_shared_param_0
)
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd1, [qualify_uninit_shared_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	ld.shared.u32 	%r1, [qualify_uninit_slot];
	st.global.u32 	[%rd2], %r1;
	ret;
}
