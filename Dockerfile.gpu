# syntax=docker/dockerfile:1.7

# =============================================================================
# Pre-built base builder image (CUDA + Rust + dev packages)
#
# Rebuild with: just gpu-base-image
# =============================================================================
FROM ghcr.io/avencera/speakrs-gpu-base:latest AS base

# =============================================================================
# cargo-chef: compute dependency recipe from lock file
# =============================================================================
FROM base AS planner

RUN cargo install cargo-chef --locked
COPY Cargo.toml Cargo.lock ./
COPY xtask/Cargo.toml xtask/Cargo.toml
COPY src/ ./src/
# Cargo.toml declares [[example]] targets, and cargo checks their files exist
COPY examples/ ./examples/
COPY xtask/ ./xtask/
RUN cargo chef prepare --recipe-path recipe.json

# =============================================================================
# cargo-chef: cook dependencies (cached layer, only re-runs when deps change)
# =============================================================================
FROM base AS deps

RUN cargo install cargo-chef --locked
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/root/.cargo/registry,id=speakrs-gpu-cargo-registry \
    --mount=type=cache,target=/root/.cargo/git,id=speakrs-gpu-cargo-git \
    cargo chef cook --release --recipe-path recipe.json --no-default-features --features cuda -p xtask

# =============================================================================
# Build the real speakrs-bm binary (deps are cached, only project code compiles)
# =============================================================================
FROM deps AS builder

COPY Cargo.toml Cargo.lock ./
COPY xtask/Cargo.toml xtask/Cargo.toml
COPY src/ ./src/
# Cargo.toml declares [[example]] targets, and cargo checks their files exist
COPY examples/ ./examples/
COPY xtask/ ./xtask/

RUN cargo build --release -p xtask --no-default-features --features cuda --bin speakrs-bm && \
    mkdir -p /opt/bin && \
    cp -P target/release/speakrs-bm /opt/bin/

# =============================================================================
# Slim runtime: binary + pyannote script only
# Models are downloaded from Hugging Face and datasets from public archives at startup
# The native CUDA backend loads cuBLAS and NVRTC from the CUDA runtime base image and cuDNN 9 from its
# libcudnn9-cuda-12 package (docker/runtime.Dockerfile)
#
# Pre-built runtime base: just gpu-runtime-image
# =============================================================================
FROM ghcr.io/avencera/speakrs-gpu-runtime:latest

COPY --from=builder /opt/bin/speakrs-bm /usr/local/bin/
COPY scripts/pyannote-bench/ /opt/pyannote-bench/

# pre-install pyannote venv (torch 2.10+cu128 matches PyPI torchcodec 0.10 ABI)
RUN cd /opt/pyannote-bench && uv sync --frozen

RUN ldconfig && \
    ln -s /usr/local/bin/speakrs-bm /usr/local/bin/sbm

RUN mkdir -p /var/run/sshd /root/.ssh /workspace && \
    echo "PermitRootLogin yes" >> /etc/ssh/sshd_config && \
    ssh-keygen -A

COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/usr/sbin/sshd", "-D"]
