.version 7.0
.target sm_80
.address_size 64
// comments must not create taint or instructions
// cvta.shared.u64 %rd9, smem; cvt.u32.u64 %r9, %rd9;
.visible .entry converted()
{
    .reg .u64 %rd<4>;
    .reg .u32 %r<2>;
    cvta.shared.u64 %rd1, smem;
    add.u64 %rd2, %rd1, 16;
    cvta.to.shared.u64 %rd3, %rd2;
    cvt.u32.u64 %r1, %rd3;
    ret;
}
.visible .entry independent()
{
    .reg .u64 %rd<4>;
    .reg .u32 %r<2>;
    /* cvta.shared.u64 %rd2, smem; */
    mov.u64 %rd2, 16;
    cvt.u32.u64 %r1, %rd2;
    ret;
}
